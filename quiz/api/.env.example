# Copy to .env on the host. Must be 640 root:www-data - python-dotenv raises on
# an unreadable file rather than skipping it, and the app loads it as www-data.
# See SPEC "Known traps".

DATABASE_URL=postgresql://quiz:CHANGEME@192.168.4.32:5432/quiz

# Used only by db/migrate.py, which deploy.sh runs before restarting the app.
# Needs rights to CREATE and ALTER, which the app role deliberately does not
# have. Leave it unset to fall back to DATABASE_URL - but then migrations that
# create tables or views will fail.
MIGRATE_DATABASE_URL=postgresql://postgres:CHANGEME@192.168.4.32:5432/quiz

# Admin endpoints answer only from these. Tailscale CGNAT + LAN + localhost.
TRUSTED_NETS=100.64.0.0/10,192.168.0.0/16,127.0.0.0/8,fd7a:115c:a1e0::/48

# Anti-flood. Counted in process memory against the Cloudflare client IP,
# which is never written to the database.
START_LIMIT_PER_HOUR=20
FOLLOWUP_LIMIT_PER_HOUR=5

# Minimum seconds between start and submit. Below this it is a bot.
MIN_FILL_SECONDS=15
