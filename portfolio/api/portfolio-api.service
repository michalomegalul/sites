[Unit]
Description=dobsinsky.xyz portfolio API
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/sites/portfolio/api
EnvironmentFile=/opt/sites/portfolio/api/.env
ExecStart=/opt/sites/portfolio/api/venv/bin/gunicorn -w 2 -b 127.0.0.1:5050 app:app
Restart=always

# gunicorn 26's control server writes into $HOME. www-data's home is /var/www,
# which it cannot write, so every start logged "Control server error:
# Permission denied: '/var/www/.gunicorn'". systemd creates this directory
# owned by User= on each start and removes it on stop.
RuntimeDirectory=portfolio-api
Environment=HOME=/run/portfolio-api

# visitors.db and now.json live here, not in the checkout. systemd creates
# /var/lib/portfolio-api owned by User= on first start, which is what makes the
# directory writable — SQLite needs to create its journal beside the database,
# so a writable file in a read-only directory is not enough.
StateDirectory=portfolio-api
Environment=STATE_DIR=/var/lib/portfolio-api

[Install]
WantedBy=multi-user.target
