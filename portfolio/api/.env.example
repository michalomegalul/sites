# Trusted networks (comma separated CIDRs) - Tailscale CGNAT + LAN + localhost
TRUSTED_NETS=100.64.0.0/10,192.168.0.0/16,127.0.0.0/8,fd7a:115c:a1e0::/48

# Proxmox API - create a token: Datacenter > Permissions > API Tokens
# give it PVEAuditor role only (read-only!)
PVE_HOST=https://192.168.4.10:8006
PVE_NODE=pve
PVE_TOKEN=portfolio@pam!readonly=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PVE_VERIFY=0

# CrowdSec counter in the status bar. Needs the sudoers rule from the README -
# without it the endpoint 502s and the counter stays hidden, which is harmless.
# Set to 0 to switch the counter off deliberately.
CROWDSEC=1
CSCLI=/usr/bin/cscli

# Where /api/quizcount fetches the survey response count from (server-side, cached 10 min).
QUIZ_COUNT_URL=https://quiz.dobsinsky.dev/api/public/count
